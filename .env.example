# ---- required ----
BOT_TOKEN=put_your_bot_token_here
API_ID=put_your_telegram_api_id_here
API_HASH=put_your_telegram_api_hash_here

# ---- recommended ----
# Your own Telegram user id (ask @userinfobot). When set, ONLY you can use the bot.
OWNER_ID=

# ---- optional ----
MAX_FILE_SIZE_MB=1800
MAX_DURATION_SECONDS=7200
MAX_PLAYLIST_ITEMS=200
MAX_CONCURRENT_JOBS=1
DOWNLOAD_DIR=downloads
LOG_LEVEL=INFO

# MP3 quality: 0 = best VBR (~245 kbps, recommended) ... 9 = smallest, or a fixed bitrate like 320k
MP3_QUALITY=0

# Path to a Netscape-format cookies.txt (only if YouTube asks you to sign in)
COOKIES_FILE=

# JavaScript runtime used by yt-dlp for YouTube: auto | node | deno | none
JS_RUNTIME=auto
